# ---- Python / backend ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Node / Angular frontend ----
node_modules/
dist/
.angular/

# ---- Secrets: never commit these ----
# `.env` alone matches ONLY the file named exactly .env. Backups and variants
# such as .env.backup, .env.local or .env.production would have slipped
# through, so ignore every .env.* and then re-include the template.
.env
.env.*
!.env.example
*.pem
*.key
aws-credentials*

# ---- Editors / OS ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# diagnostic output, never useful to anyone else
debug_register.log
test_s3.db
