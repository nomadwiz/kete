# TEMPLATE ONLY — this file IS committed to GitHub.
# Never put a real secret in here.
#
# To use it: copy this file, rename the copy to  .env  (no .example), and put
# your real values in that copy. .env is gitignored, so it stays on your
# machine only — editing it changes nothing for anybody else.

# Where the client sends every API call. Read once, in src/api/http.ts, and
# bound nowhere else. The value below is the deployed API — the EC2 instance
# behind the nginx reverse proxy — and it is the address the whole team
# develops against, so copying this file unedited gives you a working client.
# Point it at a backend you are running yourself only while you are changing
# that backend.
#
# A trailing slash does no harm. src/api/http.ts drops any trailing slash from
# this address's path before appending each request path, which already starts
# with one, so http://host/ and http://host both reach /profile.
VITE_API_BASE_URL=http://3.107.215.104
