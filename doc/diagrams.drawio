        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USER ||--o| PROFILE : \&quot;has\&quot;\n    USER ||--o| NUTRITION_TARGET : \&quot;has\&quot;\n    USER ||--o{ RECIPE : \&quot;owns\&quot;\n    USER ||--o{ PLAN_SLOT : \&quot;plans\&quot;\n    RECIPE ||--o{ PLAN_SLOT : \&quot;scheduled in\&quot;\n\n    USER {\n        int user_id PK\n        varchar email UK\n        varchar password_hash\n        varchar display_name\n        datetime created_at\n    }\n    PROFILE {\n        int profile_id PK\n        int user_id FK \&quot;unique, 1:1\&quot;\n        decimal weight_kg\n        decimal height_cm\n        int age\n        varchar sex \&quot;male / female\&quot;\n        varchar activity_level \&quot;sedentary..very_active\&quot;\n        datetime updated_at\n    }\n    NUTRITION_TARGET {\n        int target_id PK\n        int user_id FK \&quot;unique, 1:1\&quot;\n        decimal energy_kcal\n        decimal protein_g\n        decimal carbs_g\n        decimal fat_g\n        datetime computed_at\n    }\n    RECIPE {\n        int recipe_id PK\n        int user_id FK \&quot;owner\&quot;\n        varchar name\n        varchar cuisine\n        text ingredients\n        text steps\n        int servings\n        decimal energy_kcal \&quot;per serving\&quot;\n        decimal protein_g \&quot;per serving\&quot;\n        decimal carbs_g \&quot;per serving\&quot;\n        decimal fat_g \&quot;per serving\&quot;\n        varchar photo_url \&quot;cloud object storage\&quot;\n        datetime created_at\n    }\n    PLAN_SLOT {\n        int slot_id PK\n        int user_id FK\n        int recipe_id FK\n        varchar week \&quot;ISO week or start date\&quot;\n        varchar day_of_week \&quot;Mon..Sun\&quot;\n        varchar meal_position \&quot;breakfast/lunch/dinner/snack\&quot;\n        datetime created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
