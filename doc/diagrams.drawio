        <mxCell id="n62" value="photographs served directly to the browser" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9.5;fontFamily=Georgia;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380.0" y="29.4" width="215.5" height="15.2" as="geometry"/></mxCell>
        <mxCell id="n63" value="Each tier communicates only with the tier beneath it. The client cannot reach the database, because it holds no credentials and the database" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontFamily=Georgia;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="38.0" y="591.6" width="793.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="n64" value="accepts connections only from the application tier. Every access to data therefore passes through the API, where authorisation is applied." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontFamily=Georgia;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="38.0" y="607.6" width="782.5" height="16.8" as="geometry"/></mxCell>
        <mxCell id="n65" value="Solid lines show runtime requests. Dashed lines show access paths that bypass the client." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontFamily=Georgia;fontColor=#777777;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="38.0" y="629.6" width="504.6" height="16.8" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
