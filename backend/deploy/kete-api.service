# systemd unit for the Kete API on the EC2 instance.
#
# The deploy workflow (.github/workflows/deploy-backend.yml) copies this into
# /etc/systemd/system/ and restarts the service on every deploy, so edit it
# here, never on the instance.
#
# uvicorn listens on localhost only; nginx on port 80 is the public face.
# Secrets come from backend/.env, which exists only on the instance.

[Unit]
Description=Kete API (FastAPI under uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/kete/backend
ExecStart=/home/ec2-user/kete/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
