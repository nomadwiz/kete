# TEMPLATE ONLY — this file IS committed to GitHub.
# Never put a real password, endpoint or secret in here.
#
# To use it: copy this file, rename the copy to  .env  (no .example),
# and put your real values in that copy. .env is gitignored, so it stays
# on your machine only.

# --- Local PostgreSQL on your laptop ---
DB_USER=postgres
DB_PASSWORD=type_your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kete

# Put the password in exactly as you typed it when installing PostgreSQL.
# Special characters are fine — @ : / # $ are handled for you.
# Do NOT wrap it in quotes.

# --- Amazon RDS ---
# Same keys, different values. Ask the team for the real ones; they are not
# written down here on purpose.
#
# DB_USER=<rds master username>
# DB_PASSWORD=<rds master password>
# DB_HOST=<instance>.<id>.<region>.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=kete
#
# SSL is applied automatically for any *.rds.amazonaws.com host, because RDS
# PostgreSQL 15+ refuses unencrypted connections. Override only if you must:
# DB_SSLMODE=require

# --- Amazon S3, recipe photographs ---
# The bucket is private; the API hands out time-limited links, so nothing in
# it is publicly readable.
# Credentials: on your laptop, set the two AWS_ keys below. On EC2, leave them
# out entirely — the instance role supplies them and no secret sits on disk.
#
# S3_BUCKET=<the private photos bucket>
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=<from the IAM user>
# AWS_SECRET_ACCESS_KEY=<from the IAM user>

# --- Which origins a browser may call this API from ---
# Comma-separated, scheme included, no trailing slash. Omit it and only the
# local dev server is allowed. Never "*", so only the client's own pages can
# read the API's answers in a browser.
#
# Laptop:  http://localhost:7377
# Server:  the client's CloudFront address, https://<distribution>.cloudfront.net
# CORS_ORIGINS=http://localhost:7377,http://127.0.0.1:7377

# --- Signs login tokens ---
# REQUIRED. The API refuses to start without it, and refuses any value starting
# "dev-only-secret". Generate your own:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value on the server from the one on your laptop, so a leaked
# development secret cannot mint tokens against real data.
JWT_SECRET=<generate your own, see above>
