# Copy this file, rename the copy to  .env  (no .example on the end),
# then fill in your real password below.
#
# .env is listed in .gitignore so it never gets committed. That matters:
# database passwords and AWS keys must never end up on GitHub.

# --- Local PostgreSQL on your laptop (now) ---
DB_USER=postgres
DB_PASSWORD=type_your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kete

# Put the password in exactly as you typed it when installing PostgreSQL.
# Special characters are fine here — @ : / # $ and so on are handled for you.
# Do NOT wrap it in quotes.

# --- Amazon RDS (later) ---
# Only DB_HOST, DB_USER and DB_PASSWORD change. Everything else stays.
# DB_HOST=kete-db.abc123.ap-southeast-2.rds.amazonaws.com

